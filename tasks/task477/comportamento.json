      "codigoOriginal": "WITH ThisForm\n\tWITH .pagina.dados\n\t\tlcCodigo=.GetCodigos.Value\n\t\tlcTipo=.getTipos.Value\n\t\tIF ! EMPTY(.getTipos.Value)\n\t\t\tSELECT crSigBaOco\n\t\t\tLOCATE FOR Tipos = lcTipo .AND. codigos = ALLTRIM(lcCodigo)\n\t\t\tThisForm.Busca=1\n\t\tELSE\n\t\t\tSELECT crSigBaOco\n\t\t\tSET ORDER TO Codigos\n\t\t\tSET NEAR on\n\t\t\tSEEK lcCodigo\n\t\t\tSET NEAR off\n\t\t\tThisform.pagina.lista.grade.columns(2).setfocus\n\t\t\tThisForm.Busca=2\n\t\tEndif\n\tENDWITH\nEndWith\n",
