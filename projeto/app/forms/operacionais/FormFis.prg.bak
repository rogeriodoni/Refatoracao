*============================================================================
* FormFis.prg - Cadastro da Impressora Fiscal
* Migracao de: SigCdFis.SCX  |  Tipo: OPERACIONAL (dialogo plano)
* Herda: FormBase  |  Sem PageFrame - layout plano identico ao legado
*============================================================================

DEFINE CLASS FormFis AS FormBase

    *--------------------------------------------------------------------------
    * Propriedades visuais identicas ao SCX legado (PILAR 1)
    *--------------------------------------------------------------------------
    Width       = 800
    Height      = 273
    AutoCenter  = .T.
    TitleBar    = 0
    ShowWindow = 1
    ControlBox  = .F.
    MaxButton   = .F.
    MinButton   = .F.
    WindowType  = 1
    DataSession = 2
    BorderStyle = 2
    ShowTips    = .T.
    Caption     = "Cadastro da Impressora Fiscal"

    *--------------------------------------------------------------------------
    * Business Object
    *--------------------------------------------------------------------------
    this_oBusinessObject = .NULL.

    *==========================================================================
    * Init
    * DODEFAULT() -> FormBase.Init() -> InicializarForm()
    * FormBase.Init() tambem corrige SET DATE/CENTURY para DataSession=2
    *==========================================================================
    PROCEDURE Init()
        RETURN DODEFAULT()
    ENDPROC

    *==========================================================================
    * InicializarForm
    * Cria BO, inicializa cursor, monta controles visuais e vincula eventos.
    *==========================================================================
    PROTECTED PROCEDURE InicializarForm()
        LOCAL loc_lSucesso

        loc_lSucesso = .F.

        TRY
            THIS.this_oBusinessObject = CREATEOBJECT("FisBO")

            IF VARTYPE(THIS.this_oBusinessObject) != "O"
                MsgErro("Erro ao criar FisBO." + CHR(13) + ;
                        "VARTYPE retornou: " + VARTYPE(THIS.this_oBusinessObject), ;
                        "Erro em FormFis.InicializarForm")
            ELSE
                IF FILE(gc_4c_CaminhoIcones + "new_background.jpg")
                    THIS.Picture = gc_4c_CaminhoIcones + "new_background.jpg"
                ENDIF

                THIS.this_oBusinessObject.InicializarCursor()
                THIS.this_oBusinessObject.CarregarDeArquivo()

                THIS.ConfigurarPageFrame()
                THIS.ConfigurarPaginaLista()
                THIS.TornarControlesVisiveis(THIS)

                THIS.AlternarPagina(1)

                loc_lSucesso = .T.
            ENDIF

        CATCH TO loc_oErro
            MsgErro(loc_oErro.Message + CHR(13) + ;
                    "Linha: " + TRANSFORM(loc_oErro.LineNo) + CHR(13) + ;
                    "Procedure: " + loc_oErro.Procedure, ;
                    "Erro em FormFis.InicializarForm")
        ENDTRY

        RETURN loc_lSucesso
    ENDPROC

    *==========================================================================
    * ConfigurarPageFrame
    * SigCdFis (SCX legado, Width=800 Height=273) eh dialog PLANO sem PageFrame.
    * PILAR 1 (UX pixel-perfect): manter layout flat identico ao legado ao inves
    * de introduzir abas artificialmente. Esta rotina organiza as tres regioes
    * visuais do form (cabecalho, campos de configuracao, botoes de acao)
    * delegando para os helpers dedicados, preservando o papel arquitetural de
    * "ConfigurarPageFrame" como ponto de entrada da montagem visual.
    *==========================================================================
    PROTECTED PROCEDURE ConfigurarPageFrame()
        THIS.ConfigurarCabecalho()
        THIS.ConfigurarBotoes()
        THIS.ConfigurarCampos()
    ENDPROC

    *==========================================================================
    * ConfigurarCabecalho
    * Container cinza escuro com titulos sobrepostos (cntSombra do legado)
    *==========================================================================
    PROTECTED PROCEDURE ConfigurarCabecalho()
        THIS.AddObject("cnt_4c_Sombra", "Container")
        WITH THIS.cnt_4c_Sombra
            .Top         = 0
            .Left        = -1
            .Width       = THIS.Width
            .Height      = 80
            .BorderWidth = 0
            .BackStyle   = 1
            .BackColor   = RGB(100,100,100)
            .Visible     = .T.
        ENDWITH

        THIS.cnt_4c_Sombra.AddObject("lbl_4c_LblSombra", "Label")
        WITH THIS.cnt_4c_Sombra.lbl_4c_LblSombra
            .FontBold      = .T.
            .FontName      = "Tahoma"
            .FontSize      = 18
            .FontUnderline = .F.
            .WordWrap      = .T.
            .Alignment     = 0
            .AutoSize      = .F.
            .BackStyle     = 0
            .Height        = 40
            .Left          = 10
            .Top           = 18
            .Width         = 769
            .ForeColor     = RGB(0,0,0)
            .Caption       = "Cadastro da Impressora Fiscal"
        ENDWITH

        THIS.cnt_4c_Sombra.AddObject("lbl_4c_LblTitulo", "Label")
        WITH THIS.cnt_4c_Sombra.lbl_4c_LblTitulo
            .FontBold      = .T.
            .FontName      = "Tahoma"
            .FontSize      = 18
            .WordWrap      = .T.
            .Alignment     = 0
            .AutoSize      = .F.
            .BackStyle     = 0
            .Height        = 46
            .Left          = 10
            .Top           = 17
            .Width         = 769
            .ForeColor     = RGB(255,255,255)
            .Caption       = "Cadastro da Impressora Fiscal"
        ENDWITH
    ENDPROC

    *==========================================================================
    * ConfigurarBotoes
    * Botoes Confirmar e Encerrar standalone (Ok e cancela do legado)
    * Standalone com Picture requer Themes=.T. + DisabledPicture
    *==========================================================================
    PROTECTED PROCEDURE ConfigurarBotoes()
        THIS.AddObject("cmd_4c_Confirmar", "CommandButton")
        WITH THIS.cmd_4c_Confirmar
            .Top             = 3
            .Left            = 649
            .Width           = 75
            .Height          = 75
            .Caption         = "Confirmar"
            .Picture         = gc_4c_CaminhoIcones + "cadastro_salvar_60.jpg"
            .DisabledPicture = gc_4c_CaminhoIcones + "cadastro_salvar_60.jpg"
            .Themes          = .T.
            .FontName        = "Tahoma"
            .FontBold        = .T.
            .FontItalic      = .T.
            .FontSize        = 8
            .ForeColor       = RGB(90,90,90)
            .BackColor       = RGB(255,255,255)
            .SpecialEffect   = 0
            .PicturePosition = 13
            .MousePointer    = 15
            .WordWrap        = .T.
            .AutoSize        = .F.
        ENDWITH
        BINDEVENT(THIS.cmd_4c_Confirmar, "Click", THIS, "BtnConfirmarClick")

        THIS.AddObject("cmd_4c_Encerrar", "CommandButton")
        WITH THIS.cmd_4c_Encerrar
            .Top             = 3
            .Left            = 724
            .Width           = 75
            .Height          = 75
            .Caption         = "Encerrar"
            .Picture         = gc_4c_CaminhoIcones + "cadastro_sair_60.jpg"
            .DisabledPicture = gc_4c_CaminhoIcones + "cadastro_sair_60.jpg"
            .Themes          = .T.
            .FontName        = "Tahoma"
            .FontBold        = .T.
            .FontItalic      = .T.
            .FontSize        = 8
            .ForeColor       = RGB(90,90,90)
            .BackColor       = RGB(255,255,255)
            .SpecialEffect   = 0
            .PicturePosition = 13
            .MousePointer    = 15
            .WordWrap        = .T.
            .AutoSize        = .F.
            .Cancel          = .T.
        ENDWITH
        BINDEVENT(THIS.cmd_4c_Encerrar, "Click", THIS, "BtnEncerrarClick")
    ENDPROC

