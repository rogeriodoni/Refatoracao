            .FontSize      = 8
            .Alignment     = 3
            .Height        = 23
            .Left          = 253
            .Top           = 138
            .Width         = 80
            .SpecialEffect = 1
            .Value         = DATE()
            .ForeColor     = RGB(0, 0, 0)
            .BorderColor   = RGB(100, 100, 100)
            .Themes        = .F.
            .Visible       = .T.
        ENDWITH

        THIS.AddObject("lbl_4c_Label3", "Label")
        WITH THIS.lbl_4c_Label3
