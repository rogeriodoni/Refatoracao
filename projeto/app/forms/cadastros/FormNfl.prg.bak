        loc_oPagina.pgf_4c_Abas.Page3.Caption  = "Desdobramento"
        loc_oPagina.pgf_4c_Abas.Page4.Caption  = "Produtos"
        loc_oPagina.pgf_4c_Abas.Page5.Caption  = "Impostos"
        loc_oPagina.pgf_4c_Abas.Page6.Caption  = "Transporte"
        loc_oPagina.pgf_4c_Abas.Page7.Caption  = "Rodap" + CHR(233)
        loc_oPagina.pgf_4c_Abas.Page8.Caption  = "Dados Fatura"
        loc_oPagina.pgf_4c_Abas.Page9.Caption  = "Servi" + CHR(231) + "os"
        loc_oPagina.pgf_4c_Abas.Page10.Caption = "Outros"

