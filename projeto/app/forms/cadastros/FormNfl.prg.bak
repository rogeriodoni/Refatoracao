                loc_oBusca.mAddColuna("Razas", "", "Raz" + CHR(227) + "o Social")
                loc_oBusca.Mostrar()
                IF loc_oBusca.this_lSelecionou AND USED("cursor_4c_BuscaEmpDest")
                    SELECT cursor_4c_BuscaEmpDest
                    loc_oCtrl.Value = ALLTRIM(CEmps)
                ENDIF
