                loc_oPg2.txt_4c_DCONTAOs.Value = ""
                loc_oPg2.txt_4c_ContaOs.SetFocus()
            ENDIF

            IF USED("cursor_4c_ContaOsVal")
                USE IN cursor_4c_ContaOsVal
